# Copy to .env in the repo root and fill in. .env is gitignored.
# Login for docker.graphaware.com. Used only to create a temporary Secrets
# Manager secret for the AMI build. The secret is deleted when the build ends.
REGISTRY_USER=
REGISTRY_PASSWORD=
# AMI the stack launches. ami/create_ami.py writes the ID to ami/ami-id.txt.
HUME_AMI_ID=
# Comma-separated list of single /32 addresses allowed to reach the load
# balancer, one to five. Find yours at https://checkip.amazonaws.com.
# stack/allowlist.py keeps this line in step with the deployed stack.
ALLOWED_CIDRS=
# Optional. AWS profile for stack/deploy.py. The default is marketplace, and
# --profile overrides it.
# AWS_PROFILE=marketplace
# Hume licence key. deploy.py stores it in Secrets Manager, never in the stack.
HUME_LICENCE_KEY=
# Route 53 public hosted zone ID for the stack's DNS records. Required. Give
# the ID only, without /hostedzone/. The zone is shared, so teardown removes
# only the stack's own validation records.
HUME_HOSTED_ZONE_ID=
# The base of the three Hume host names. Required. The stack creates
# hume.<base>, hume-api.<base> and hume-media.<base>. The base must be the zone
# name or sit below it, for example example.com. Use a different base for every
# stack that runs at the same time, for example wooz.example.com.
HUME_BASE_DOMAIN=
# Sign-in through OIDC, the default. The issuer address and the client id of the
# hume-web app client. Both are ids, not secrets. "verify/cognito.py env"
# writes them for the Cognito test pool. See
# docs/guides/run-book.md#write-the-oidc-settings.
HUME_OIDC_ISSUER_URI=
HUME_OIDC_CLIENT_ID=
# The name the Neo4j EE stack advertises, for example neo4j-oidc.neo4j.local.
# "verify/cognito.py env" reads it to write the Neo4j EE settings.
# NEO4J_ADVERTISED_DNS=
# Optional. Set it to true when the Neo4j EE stack installs no Bloom.
# "verify/cognito.py env" then leaves the Bloom address off the neo4j client.
# NO_BLOOM=false
# Optional. Native keeps the built-in administrator with a generated password,
# and then the two settings above are not needed. The default is Oidc.
# HUME_AUTH_PROVIDER=Oidc
# Optional. The provider groups and the Hume role each one grants, the path of
# the groups claim, and the claim that names the user. The defaults suit
# Cognito.
# HUME_OIDC_ROLES_MAPPINGS=hume-admins=ADMINISTRATOR,hume-users=USER
# spine_demo.py adds spine-analysts=SPINE_ANALYST,spine-officers=SPINE_OFFICER
# to the stack when the Spine demo is set up.
# HUME_OIDC_ROLES_CLAIM_PATH=$['cognito:groups']
# HUME_OIDC_PRINCIPAL_CLAIM=username
# Optional. The address of the provider's signing keys and the scopes hume-web
# requests. Leave both unset for Cognito. See
# docs/reference/infrastructure-setup-details.md#other-oidc-providers.
# HUME_OIDC_JWK_SET_URI=
# HUME_OIDC_SCOPE=openid profile email
# The Neo4j EE stack. Every setting in this block is required.
# The name of the three-server Neo4j EE stack, in the same account and Region.
# Hume joins its VPC and connects to its cluster. The stack reads the VPC, the
# subnets, the security groups, the host, the app user and its secret from
# Parameter Store under /neo4j-ee/<name>/. "stack/neo4j_env.py <neo4j stack>"
# checks those values and writes this line. See
# docs/guides/run-book.md#read-the-neo4j-values.
HUME_NEO4J_STACK_NAME=
# The truststore secret. "deploy.py truststore" builds it from every certificate
# in HUME_NEO4J_CA_FILE and prints this line with the ARN filled in. It needs
# keytool from a JDK, or docker. The file holds the Neo4j CA and the roots of
# the identity provider, because the truststore replaces the JVM default roots
# and the API fetches the provider's signing keys over HTTPS. The run book joins
# .deploy/neo4j-ca.pem with stack/truststore/amazon-trust-services-roots.pem
# into stack/.deploy/truststore-ca.pem.
HUME_NEO4J_CA_FILE=
HUME_NEO4J_TRUSTSTORE_SECRET_ARN=
# Optional. Spine demo only. The path of the Spine config directory.
# spine_demo.py packs it into the secret hume/<stack>/spine-config, and the
# stack imports it into Hume. A copy of the hume-quickstart config/hume/spine
# files is in demo/spine/hume-config.
# HUME_SPINE_CONFIG_DIR=demo/spine/hume-config
